# Copy to .env and fill real values. NEVER commit .env.
# Each tool reads only keys it needs.

# Example API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google OAuth (paths to gitignored files)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# --- 9router (docker compose) ---
# Required. Generate secret: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
API_KEY_SECRET=change-me
MACHINE_ID_SALT=change-me
# Local: 127.0.0.1 (localhost only). VPS behind reverse proxy: keep 127.0.0.1. Direct expose: 0.0.0.0
NINEROUTER_BIND=127.0.0.1
NINEROUTER_PORT=20128
# VPS: public URL, set AUTH_COOKIE_SECURE=true + REQUIRE_API_KEY=true when on HTTPS
BASE_URL=http://localhost:20128
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false
ENABLE_REQUEST_LOGS=false
