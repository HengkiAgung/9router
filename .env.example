# Copy to .env and fill real values. NEVER commit .env.
# Each tool reads only keys it needs.

# Example API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google OAuth (paths to gitignored files)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# --- 9router (docker compose) ---
# Required. Generate secret: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
API_KEY_SECRET=change-me
MACHINE_ID_SALT=change-me
# Local: 127.0.0.1 (localhost only). VPS behind reverse proxy: keep 127.0.0.1. Direct expose: 0.0.0.0
NINEROUTER_BIND=127.0.0.1
NINEROUTER_PORT=20128
# VPS: public URL, set AUTH_COOKIE_SECURE=true + REQUIRE_API_KEY=true when on HTTPS
BASE_URL=http://localhost:20128
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false
ENABLE_REQUEST_LOGS=false

# --- Orkestra (tools/orchestrator.py) ---
# API key from the 9router dashboard. On other machines put these two lines in ~/.config/orkestra/.env
NINEROUTER_API_KEY=
ORCH_BASE_URL=https://airouter.hengkiagung.my.id/v1

# --- Kantor (multi-agent office) limits ---
# Sized for a 2 GB RAM / 2 vCPU server (measured 2026-11-03). Raise these when you scale up.
# Workers that may exist at once (hired, holding history). ~2 MB RAM each.
KANTOR_MAX_WORKERS=10
# Workers calling a model at the same time. Kenari free models rejected 3 of 8 concurrent requests (free_quota_rpm).
KANTOR_MAX_ACTIVE=4
# Light shell commands at the same time (python, git, grep, tests: 2-12 MB each).
KANTOR_MAX_COMMANDS=2
# Heavy commands at the same time (npm, node, builds, pip install, docker: 100 MB to 1.5 GB each).
KANTOR_MAX_HEAVY_COMMANDS=1
# How many levels deep workers may hire workers (manager -> worker -> sub-worker = 2).
KANTOR_MAX_HIRE_DEPTH=2
# Pause new model calls and commands while the server has less free RAM than this (MemAvailable).
KANTOR_MIN_FREE_MB=250
# Hard RAM cap for the whole Kantor service, its commands included (systemd MemoryMax / MemoryHigh).
KANTOR_MEMORY_MAX_MB=512
KANTOR_MEMORY_HIGH_MB=400
# Kantor service (tools/kantor/deploy.sh)
KANTOR_DOMAIN=myoffice.hengkiagung.my.id
KANTOR_PORT=4610
# Models. A worker's model comes from its task's difficulty (judged automatically unless given).
KANTOR_MODEL_EASY=ag/gemini-3.8-flash
KANTOR_MODEL_NORMAL=ag/claude-sonnet-4-6
KANTOR_MODEL_HARD=ag/claude-opus-4-6-thinking
# Tried in order when a worker's model fails. Different providers, since limits hit per provider/account.
KANTOR_FALLBACK_MODELS=ag/claude-sonnet-4-6,ollama/gpt-oss:120b
# Last resort when all of the above fail (usually limits); the UI shows a warning while one is used.
KANTOR_CHEAP_MODELS=ollama/gemma4:31b,kenari/glm-4-7-flash:free,kenari/qwen3-8-27b:free
# Paid models: never automatic. An agent must justify one and you approve it (model=note;model=note).
# Both need Ollama usage credits (they answer HTTP 402 on the free plan).
KANTOR_PAID_MODELS=ollama/minimax-m3=MiniMax M3, strong agentic coder (Ollama credits);ollama/deepseek-v4.1-flash:cloud=DeepSeek V4.1 Flash (Ollama credits)
# Tool calls per task before a worker must report.
KANTOR_MAX_STEPS=40
# File edits apply without asking (workers hired by workers edit their own branch). Commands always ask,
# except read-only ones (ls, cat, grep, git status/diff/log); true skips asking for every command.
KANTOR_AUTO_EDIT=true
KANTOR_AUTO_APPROVE_COMMANDS=false
